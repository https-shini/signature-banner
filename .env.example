# Copie para .env apenas no desenvolvimento. Produção usa variáveis da Render.
HOST=127.0.0.1
PORT=3000
DATABASE_URL=postgresql://postgres@127.0.0.1:54329/identity_studio
DATABASE_SSL=false
STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=./data/media
# Produção exige STORAGE_DRIVER=supabase, DATABASE_SSL=true e estas variáveis:
# SUPABASE_URL=https://SEU-PROJETO.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=configure-no-servidor
# SUPABASE_STORAGE_BUCKET=identity-studio
# Obrigatório em produção ou ao usar HOST=0.0.0.0; ao menos 32 caracteres.
# APP_ACCESS_TOKEN=

# Produção Supabase: CA oficial apenas para PostgreSQL
# DATABASE_SSL_CA_FILE=server/certs/supabase-prod-ca-2021.crt
